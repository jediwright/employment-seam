{
  "name": "@automerge/automerge-repo-react-hooks",
  "version": "2.6.0-subduction.40",
  "description": "Hooks to access an Automerge Repo from your react app.",
  "repository": "https://github.com/automerge/automerge-repo/tree/main/packages/automerge-repo-react-hooks",
  "author": "Peter van Hardenberg <pvh@pvh.ca>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "dependencies": {
    "@automerge/automerge": "3.3.0-fragments.2",
    "eventemitter3": "^5.0.4",
    "@automerge/automerge-repo": "2.6.0-subduction.40"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "subduction"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "watch": "vite build --watch",
    "visualize": "VISUALIZE=true vite build"
  }
}